[Unit]
Description=ROYALTIM-3 dedicated server
After=network-online.target
Wants=network-online.target

[Service]
User=royaltim
WorkingDirectory=/opt/royaltim
Environment=HOME=/opt/royaltim
ExecStart=/opt/royaltim/royaltim_server --headless -- --server --port=7777 --mode=br --min-players=2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
